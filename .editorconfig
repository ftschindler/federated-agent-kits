# EditorConfig — editor-layer half of LF enforcement (see .gitattributes + the
# mixed-line-ending pre-commit hook for the other two layers).
# https://editorconfig.org
root = true

[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8
indent_style = space
indent_size = 2

[*.{mjs,js,json,jsonc}]
indent_size = 2

[Makefile]
indent_style = tab
